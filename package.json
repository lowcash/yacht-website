{
  "name": "yacht-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ip": "vite --host 0.0.0.0",
    "build": "vite build && node ./scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 3103",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "analyze:unused": "knip --config knip.json --no-exit-code",
    "analyze:unused:strict": "knip --config knip.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:baseline": "playwright test tests/e2e/smoke.spec.ts tests/e2e/smoke.desktop.spec.ts",
    "test:e2e:baseline:ci": "mkdir -p ./test-results && playwright test tests/e2e/smoke.spec.ts tests/e2e/smoke.desktop.spec.ts --reporter=json > ./test-results/playwright-baseline.json",
    "perf:lighthouse": "pnpm run perf:lighthouse:desktop && pnpm run perf:lighthouse:mobile",
    "perf:lighthouse:desktop": "start-server-and-test \"pnpm run preview\" http://127.0.0.1:4173 \"node ./scripts/run-lighthouse.mjs desktop\"",
    "perf:lighthouse:mobile": "start-server-and-test \"pnpm run preview\" http://127.0.0.1:4173 \"node ./scripts/run-lighthouse.mjs mobile\"",
    "perf:lighthouse:baseline": "pnpm run build && pnpm run perf:lighthouse && node ./scripts/verify-lighthouse-thresholds.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.2",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^0.487.0",
    "motion": "14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.3.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.4.0",
    "knip": "^6.3.0",
    "lighthouse": "^12.8.2",
    "playwright": "1.65.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "start-server-and-test": "^3.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.14.0"
}
