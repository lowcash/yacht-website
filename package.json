{
  "name": "yacht-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ip": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 3103",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "analyze:unused": "knip --config knip.json --no-exit-code",
    "analyze:unused:strict": "knip --config knip.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:baseline": "playwright test tests/e2e/smoke.spec.ts tests/e2e/smoke.desktop.spec.ts",
    "test:e2e:baseline:ci": "mkdir -p ./test-results && playwright test tests/e2e/smoke.spec.ts tests/e2e/smoke.desktop.spec.ts --reporter=json > ./test-results/playwright-baseline.json",
    "perf:lighthouse": "npm run perf:lighthouse:desktop && npm run perf:lighthouse:mobile",
    "perf:lighthouse:desktop": "start-server-and-test \"npm run preview\" http://127.0.0.1:4173 \"node ./scripts/run-lighthouse.mjs desktop\"",
    "perf:lighthouse:mobile": "start-server-and-test \"npm run preview\" http://127.0.0.1:4173 \"node ./scripts/run-lighthouse.mjs mobile\"",
    "perf:lighthouse:baseline": "npm run build && npm run perf:lighthouse && node ./scripts/verify-lighthouse-thresholds.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.2",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "*",
    "lucide-react": "^0.487.0",
    "motion": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.59.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "knip": "^6.3.0",
    "lighthouse": "^12.8.2",
    "playwright": "^1.59.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "start-server-and-test": "^3.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^6.4.2"
  }
}
